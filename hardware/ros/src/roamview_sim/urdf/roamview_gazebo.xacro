<?xml version="1.0"?>
<!--
  Gazebo side of RoamView: the drive "firmware", the sensors and what they publish.
  Every Gazebo topic lives under /model/roamview/...; config/bridge.yaml maps them to ROS 2 names.
  Plugin names are the same in Gazebo Harmonic (gz-sim 8) and Jetty (gz-sim 10).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <gazebo>
    <!-- Plays the ESP32 motor loop: turns a velocity command into wheel speeds, with the firmware's
         speed and acceleration limits, and integrates wheel odometry (odom -> base_footprint). -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${TRACK}</wheel_separation>
      <wheel_radius>${WHEEL_R}</wheel_radius>
      <topic>/model/roamview/cmd_vel</topic>
      <odom_topic>/model/roamview/odometry</odom_topic>
      <tf_topic>/model/roamview/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
      <max_linear_velocity>$(arg max_speed)</max_linear_velocity>
      <min_linear_velocity>-$(arg max_speed)</min_linear_velocity>
      <max_angular_velocity>2.0</max_angular_velocity>
      <min_angular_velocity>-2.0</min_angular_velocity>
      <max_linear_acceleration>$(arg accel)</max_linear_acceleration>
      <min_linear_acceleration>-$(arg decel)</min_linear_acceleration>
      <max_angular_acceleration>3.0</max_angular_acceleration>
      <min_angular_acceleration>-3.0</min_angular_acceleration>
    </plugin>

    <!-- Wheel, suspension and caster angles -> /joint_states, so robot_state_publisher can move them in RViz -->
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/model/roamview/joint_states</topic>
    </plugin>

    <!-- Where the robot really is (a simulator-only "ground truth"), to compare with wheel odometry -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odom_topic>/model/roamview/ground_truth</odom_topic>
      <tf_topic>/model/roamview/ground_truth_tf</tf_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
      <dimensions>3</dimensions>
    </plugin>
  </gazebo>

  <!-- D500 DTOF LiDAR: 360 deg, 0.03-12 m, 10 Hz, about 450 points per turn -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <topic>/model/roamview/scan</topic>
      <frame_id>lidar_link</frame_id>          <!-- Gazebo Jetty (gz-sensors 10) -->
      <gz_frame_id>lidar_link</gz_frame_id>    <!-- Gazebo Harmonic (gz-sensors 8) -->
      <lidar>
        <scan>
          <horizontal>
            <samples>450</samples>
            <resolution>1</resolution>
            <min_angle>${-PI}</min_angle>
            <max_angle>${PI - 2*PI/450}</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.03</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- BNO086 inside the OAK-D Pro W -->
  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <topic>/model/roamview/imu</topic>
      <frame_id>imu_link</frame_id>          <!-- Gazebo Jetty (gz-sensors 10) -->
      <gz_frame_id>imu_link</gz_frame_id>    <!-- Gazebo Harmonic (gz-sensors 8) -->
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <!-- VL53L4CD cliff sensors: a narrow fan of 3 rays inside the 18 deg cone, 1-1300 mm, 50 Hz.
       Over a floor they read about 0.087 m; over a drop they read far (or max range). -->
  <xacro:macro name="cliff_sensor" params="name short">
    <gazebo reference="cliff_${name}_link">
      <sensor name="cliff_${short}" type="gpu_lidar">
        <always_on>true</always_on>
        <visualize>false</visualize>
        <update_rate>50</update_rate>
        <topic>/model/roamview/cliff_${short}</topic>
        <frame_id>cliff_${name}_link</frame_id>          <!-- Gazebo Jetty (gz-sensors 10) -->
        <gz_frame_id>cliff_${name}_link</gz_frame_id>    <!-- Gazebo Harmonic (gz-sensors 8) -->
        <lidar>
          <scan>
            <horizontal>
              <samples>3</samples>
              <resolution>1</resolution>
              <min_angle>-0.10</min_angle>
              <max_angle>0.10</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.005</min>
            <max>1.3</max>
            <resolution>0.001</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.002</stddev>
          </noise>
        </lidar>
      </sensor>
    </gazebo>
  </xacro:macro>
  <xacro:cliff_sensor name="front_left" short="fl"/>
  <xacro:cliff_sensor name="front_right" short="fr"/>
  <xacro:cliff_sensor name="rear_left" short="rl"/>
  <xacro:cliff_sensor name="rear_right" short="rr"/>

  <!-- OAK-D Pro W colour + depth. Colour HFOV 95 deg (Luxonis spec), scaled down to 640 x 480 at 15 Hz.
       Everything is stamped camera_link (x forward): Gazebo's point cloud uses that axis convention, so RViz
       draws it correctly. Image pipelines that expect an optical frame (z forward) need camera_optical_frame. -->
  <xacro:if value="$(arg camera)">
    <gazebo reference="camera_link">
      <sensor name="oak" type="rgbd_camera">
        <always_on>true</always_on>
        <visualize>false</visualize>
        <update_rate>15</update_rate>
        <topic>/model/roamview/oak</topic>
        <frame_id>camera_link</frame_id>          <!-- Gazebo Jetty (gz-sensors 10) -->
        <gz_frame_id>camera_link</gz_frame_id>    <!-- Gazebo Harmonic (gz-sensors 8) -->
        <camera>
          <horizontal_fov>1.658</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>12.0</far>
          </clip>
          <depth_camera>
            <clip>
              <near>0.20</near>
              <far>12.0</far>
            </clip>
          </depth_camera>
        </camera>
      </sensor>
    </gazebo>
  </xacro:if>
</robot>
